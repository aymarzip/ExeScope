<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExeScope.Agent.Windows</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExeScope.Core\ExeScope.Core.csproj" />
    <ProjectReference Include="..\ExeScope.Contracts\ExeScope.Contracts.csproj" />
    <ProjectReference Include="..\ExeScope.Engine\ExeScope.Engine.csproj" />
  </ItemGroup>

</Project>
