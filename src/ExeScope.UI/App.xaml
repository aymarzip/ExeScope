<Application x:Class="ExeScope.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark modern palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#0f141c" />
        <SolidColorBrush x:Key="CardBrush" Color="#181f2a" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#1e2736" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2e384d" />
        <SolidColorBrush x:Key="TextBrush" Color="#e6edf3" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8b949e" />
        <SolidColorBrush x:Key="AccentBrush" Color="#388bfd" />
        <SolidColorBrush x:Key="AccentGreen" Color="#3fb950" />
        <SolidColorBrush x:Key="AccentYellow" Color="#d29922" />
        <SolidColorBrush x:Key="AccentRed" Color="#f85149" />
    </Application.Resources>
</Application>
