<Window x:Class="ExeScope.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ExeScope.UI.ViewModels"
        xmlns:conv="clr-namespace:ExeScope.UI.Converters"
        xmlns:models="clr-namespace:ExeScope.Core.Models;assembly=ExeScope.Core"
        mc:Ignorable="d"
        Title="ExeScope — Платформа динамического анализа исполняемых файлов" 
        Height="880" Width="1380" MinHeight="680" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:StateToColorConverter x:Key="StateToColorConverter" />
        <conv:StateToTextConverter x:Key="StateToTextConverter" />
        <conv:ByteSizeConverter x:Key="ByteSizeConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:ProcessStatusConverter x:Key="ProcessStatusConverter" />
        <conv:ProcessStatusColorConverter x:Key="ProcessStatusColorConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource CardBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#1b2330" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Configuration / Target bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Action Controls & Status bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filter bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Tabs content -->
            <RowDefinition Height="*" />
            <!-- 4: Live metrics footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Target selection and Settings -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Target EXE -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Целевой исполняемый файл (.EXE):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TargetExePath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обзор..." Command="{Binding BrowseExeCommand}" VerticalAlignment="Bottom" Margin="0,0,16,0" />

                <!-- Output Folder -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Папка результатов сессии:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="3" Content="Выбрать..." Command="{Binding BrowseOutputDirCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- ROW 1: Controls & Status -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- State Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Состояние: " FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{Binding State, Converter={StaticResource StateToColorConverter}}" 
                            CornerRadius="4" Padding="10,4" Margin="6,0,0,0">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Main Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="▶ Ожидать запуск" Command="{Binding StartWaitingCommand}" Background="#238636" Foreground="White" BorderBrush="#2ea043" Margin="0,0,8,0" />
                    <Button Content="⏹ Остановить запись" Command="{Binding StopRecordingCommand}" Background="#da3633" Foreground="White" BorderBrush="#f85149" Margin="0,0,8,0" />
                    <Button Content="📁 Открыть папку результатов" Command="{Binding OpenResultsFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="📊 Сформировать отчёт" Command="{Binding GenerateReportCommand}" />
                </StackPanel>

                <!-- Rights / Admin Indicator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Привилегии: " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ElevationStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding IsElevated, Converter={StaticResource StateToColorConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: Filter and Search Bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Search query -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Category -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <!-- Process -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <!-- Path -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <!-- Time -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <!-- Reset button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Checkboxes -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Поиск по всему тексту события" />

                <TextBlock Grid.Column="2" Text="Категория:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextMutedBrush}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategoryOption}" Margin="0,0,10,0" />

                <TextBlock Grid.Column="4" Text="Процесс:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Grid.Column="5" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Фильтр по PID или имени процесса" />

                <TextBlock Grid.Column="6" Text="Путь:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Grid.Column="7" Text="{Binding PathFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Фильтр по пути к файлу, ключу или адресу" />

                <TextBlock Grid.Column="8" Text="Время:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Grid.Column="9" Text="{Binding TimeFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Фильтр по времени (HH:mm:ss)" />

                <Button Grid.Column="10" Content="Сброс" Command="{Binding ClearFilterCommand}" Margin="0,0,16,0" Padding="8,3" />

                <!-- Checkboxes for options -->
                <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Сохранять артефакты" IsChecked="{Binding EnableArtifactSaving}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <CheckBox Content="Захват пакетов (PCAPNG)" IsChecked="{Binding EnablePacketCapture}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: Tabs Container -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Обзор -->
            <TabItem Header="Обзор">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Target Integrity Warning Banner (if file modified after selection) -->
                            <Border BorderBrush="#f85149" BorderThickness="2" CornerRadius="6" Padding="12" Background="#3d1518" Margin="0,0,0,14"
                                    Visibility="{Binding HasTargetIntegrityWarning, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " FontSize="18" Foreground="#ff7b72" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TargetIntegrityWarning}" FontSize="13" FontWeight="Bold" Foreground="#ff7b72" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Target EXE Card -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="#141a24" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Сведения о выбранном файле" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Полный путь:" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetExeInfo.OriginalPath}" TextWrapping="Wrap" Margin="0,2" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Размер:" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetExeInfo.FileSizeBytes, Converter={StaticResource ByteSizeConverter}}" Margin="0,2" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 хеш:" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetExeInfo.Sha256}" FontFamily="Consolas" Margin="0,2" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Цифровая подпись:" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetExeInfo.SignatureStatus}" FontWeight="SemiBold" Margin="0,2" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Издатель (Subject):" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TargetExeInfo.SignerSubject}" TextWrapping="Wrap" Margin="0,2" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Центр сертификации:" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TargetExeInfo.SignerIssuer}" TextWrapping="Wrap" Margin="0,2" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sandbox Disclaimer Card -->
                            <Border BorderBrush="#b08800" BorderThickness="1" CornerRadius="6" Padding="14" Background="#1e1a0e" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="⚠ Инструкция по изоляции тестовой среды" FontSize="14" FontWeight="Bold" Foreground="#e3b341" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="18" Foreground="#d29922">
                                        ExeScope является инструментом динамического наблюдения, а не изолирующей песочницей.
                                        Запускайте исследуемые образцы только внутри отдельной выделенной виртуальной машины без доступа к личным файлам и корпоративной сети, со свежим сохранённым снимком (snapshot) для быстрого отката после анализа.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Storage Limits Card -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="#141a24" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Лимиты хранения артефактов" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                            <TextBlock Text="Макс. размер файла: " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding MaxArtifactSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,4,0" />
                                            <TextBlock Text=" МБ" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Общий бюджет хранения: " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding MaxTotalStorageMb, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,4,0" />
                                            <TextBlock Text=" МБ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Recent General Telemetry Feed -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="#141a24">
                                <StackPanel>
                                    <TextBlock Text="Журнал последних событий сессии" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding FilteredEvents}" AutoGenerateColumns="False" Height="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="110" />
                                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100" />
                                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" FontFamily="Consolas" Width="70" />
                                            <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessImage}" Width="150" />
                                            <DataGridTextColumn Header="Описание события" Binding="{Binding Summary}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 2: Дерево процессов -->
            <TabItem Header="Дерево процессов">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="12">
                    <TreeView ItemsSource="{Binding ProcessTreeNodes}" Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:ProcessNode}" ItemsSource="{Binding Children}">
                                <Border Background="#1f2838" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding ImageName}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                            <TextBlock Text="PID:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ProcessId}" FontFamily="Consolas" Margin="0,0,10,0" />
                                            <TextBlock Text="Parent PID:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ParentProcessId}" FontFamily="Consolas" Margin="0,0,10,0" />
                                            <TextBlock Text="Статус:" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding IsAlive, Converter={StaticResource ProcessStatusConverter}}" 
                                                       Foreground="{Binding IsAlive, Converter={StaticResource ProcessStatusColorConverter}}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExitCode, StringFormat={} (код: {0})}" 
                                                       Visibility="{Binding ExitCode, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ImagePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding CommandLine}" FontFamily="Consolas" FontSize="11" Foreground="#7ee787" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
            </TabItem>

            <!-- TAB 3: Файлы -->
            <TabItem Header="Файлы">
                <DataGrid ItemsSource="{Binding FilteredFileEvents}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="105" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" FontFamily="Consolas" Width="65" />
                        <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessImage}" Width="130" />
                        <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" FontWeight="SemiBold" Width="95" />
                        <DataGridTextColumn Header="Путь к файлу" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="90" />
                        <DataGridTextColumn Header="Размер (байт)" Binding="{Binding ByteCount}" Width="95" />
                        <DataGridTextColumn Header="Смещение" Binding="{Binding ByteOffset}" Width="85" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 4: Реестр -->
            <TabItem Header="Реестр">
                <DataGrid ItemsSource="{Binding FilteredRegistryEvents}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="105" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" FontFamily="Consolas" Width="65" />
                        <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessImage}" Width="130" />
                        <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" FontWeight="SemiBold" Width="110" />
                        <DataGridTextColumn Header="Ключ реестра" Binding="{Binding KeyPath}" Width="*" />
                        <DataGridTextColumn Header="Имя параметра" Binding="{Binding ValueName}" Width="160" />
                        <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 5: Сеть -->
            <TabItem Header="Сеть">
                <DataGrid ItemsSource="{Binding FilteredNetworkEvents}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="105" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" FontFamily="Consolas" Width="65" />
                        <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessImage}" Width="130" />
                        <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" FontWeight="SemiBold" Width="75" />
                        <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="95" />
                        <DataGridTextColumn Header="Локальный адрес" Binding="{Binding LocalEndpoint}" FontFamily="Consolas" Width="150" />
                        <DataGridTextColumn Header="Удалённый адрес / DNS" Binding="{Binding RemoteEndpoint}" FontFamily="Consolas" Width="*" />
                        <DataGridTextColumn Header="Корреляция" Binding="{Binding CorrelationMethod}" Width="115" />
                        <DataGridTextColumn Header="Уверенность" Binding="{Binding Confidence}" Width="90" />
                        <DataGridTextColumn Header="Объём (байт)" Binding="{Binding BytesTransferred}" Width="90" />
                        <DataGridTextColumn Header="Защита / TLS" Binding="{Binding SecurityNotes}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 6: Сохранённые артефакты -->
            <TabItem Header="Сохранённые артефакты">
                <DataGrid ItemsSource="{Binding Artifacts}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="105" />
                        <DataGridTextColumn Header="Имя артефакта" Binding="{Binding ArtifactFileName}" FontFamily="Consolas" Width="220" />
                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="90" />
                        <DataGridTextColumn Header="Статус копирования" Binding="{Binding CopyStatus}" FontWeight="SemiBold" Width="130" />
                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" FontFamily="Consolas" Width="200" />
                        <DataGridTextColumn Header="Исходный путь" Binding="{Binding OriginalPath}" Width="*" />
                        <DataGridTextColumn Header="Причина пропуска/ошибки" Binding="{Binding FailureReason}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 7: Диагностика -->
            <TabItem Header="Диагностика">
                <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas" Width="120" />
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" FontWeight="Bold" Width="80" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="140" />
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- ROW 4: Live metrics footer -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ExeScope Dynamic Sandbox Analyzer v1.0.0 — Готов к работе" 
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Всего событий: " Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalEventsCount}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Потери очереди: " Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding DroppedEventsCount}" FontWeight="Bold" 
                               Foreground="{Binding DroppedEventsCount, Converter={StaticResource StateToColorConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Объём сессии: " Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding SessionSizeBytes, Converter={StaticResource ByteSizeConverter}}" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
